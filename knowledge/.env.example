# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=your_api_key_here
# API 基础地址
OPENAI_API_BASE=https://api.deepseek.com
# 默认 LLM 模型
LLM_DEFAULT_MODEL=deepseek-flash
# 默认温度参数
LLM_DEFAULT_TEMPERATURE=0.1

# ====================
# 私有化模型服务配置
# ====================
# dense 向量化模型路径（bge-base-zh-v1.5，768 维）
BGE_BASE_ZH_MODEL_PATH=D:\path\to\models\bge-base-zh-v1.5
# 精排模型路径（bge-reranker-v2-m3）
BGE_RERANKER_MODEL_PATH=D:\path\to\models\bge-reranker-v2-m3
# 精排模型设备
BGE_RERANKER_DEVICE=cpu
# 精排模型半精度
BGE_RERANKER_FP16=0
# 项目名称诊断标志
ITEM_NAME_DIAG=1

# ====================
# Embedding General
# ====================
# 嵌入向量维度（bge-base-zh-v1.5 = 768）
EMBEDDING_DIM=768
# 嵌入模型名称（私有化部署，见 BGE_BASE_ZH_MODEL_PATH）
EMBEDDING_MODEL=bge-base-zh-v1.5

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://localhost:19530
# 知识库集合名
# CHUNKS_COLLECTION=kb_chunks_v1
CHUNKS_COLLECTION=kb_chunks_v2
ITEM_COLLECTION_NAME=item_collection
CHUNK_COLLECTION_NAME=chunk_collection

# 实体名称集合名
# ENTITY_NAME_COLLECTION=kb_graph_entity_names_v1
ENTITY_NAME_COLLECTION=kb_graph_entity_names_v2


# 商品名称集合名
# ITEM_NAME_COLLECTION=kb_item_names_v1
ITEM_NAME_COLLECTION=kb_item_names_v2
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# 对齐阈值
# 高置信阈值
HIGH_CONFIDENCE_THRESHOLD=0.8
# 中置信阈值
MID_CONFIDENCE_THRESHOLD=0.6
# 最大候选数
MAX_OPTIONS=5

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=mongodb://localhost:27017
# 数据库名
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=localhost:9000
# 访问密钥
MINIO_ACCESS_KEY=your_minio_access_key
# 私有密钥
MINIO_SECRET_KEY=your_minio_secret_key
# 存储桶名称
MINIO_BUCKET_NAME=second-brain


# ====================
# 模型服务地址（FastAPI 私有化部署）
# ====================
# dense 向量化服务
EMBEDDING_SERVICE_URL=http://localhost:8002
# 精排服务
RERANK_SERVICE_URL=http://localhost:8003
# BM25 IDF 统计文件
SPARSE_IDF_PATH=knowledge/data/bm25_idf.pkl

# ====================
# RRF 融合配置
# ====================
# RRF 粗排输出的最大文档数（即精排候选数，调小可降低重排序耗时）
RRF_MAX_RESULTS=5

# ====================
# 临时文件配置
# ====================
# 本地临时文件（导入的 md/pdf）保留天数，超期自动清理
TEMP_FILE_KEEP_DAYS=7

# ====================
# 登录鉴权配置（单用户）
# ====================
# 登录账号
ADMIN_USERNAME=your_username
# 登录密码
ADMIN_PASSWORD=your_password_here
# JWT 签名密钥
JWT_SECRET=your_jwt_secret_here

# ====================
# Other / MCP Services
# ====================
# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
MCP_DASHSCOPE_API_KEY=your_api_key_here
